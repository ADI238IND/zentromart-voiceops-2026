# Copy to .env and fill locally. Never commit .env.
GNANI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# api = recommended multilingual dense embeddings; tfidf = offline diagnostic
EMBEDDING_BACKEND=api
GNANI_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5
# Use the absolute path of the extracted dataset root; forward slashes work on Windows.
DATASET_DIR=./dataset
